+/* Literal prefilter for a whole set in one pass over the line: the bytes
+ * that are some literal's anchor (at most LIT_PF_MAX distinct, and at most 64
+ * alternatives; otherwise each alternative uses has_lit()). */
+#define LIT_PF_MAX 8
 struct altset {
   struct alt *v;
   int n;
+  int npf;                      /* distinct anchor bytes; 0 = no prefilter */
+  unsigned char pf[LIT_PF_MAX];     /* the anchor bytes */
+  uint64_t pfmask[LIT_PF_MAX];      /* alternatives anchored on pf[k] */
+  unsigned char pfslot[256];    /* byte -> k + 1, or 0 */
 };
 
