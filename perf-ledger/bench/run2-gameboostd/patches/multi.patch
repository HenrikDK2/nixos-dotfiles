+/* Bit i set: alternative i's literal occurs in s. Finds every position that
+ * holds an anchor byte (16 at a time with SSE2) and confirms each literal
+ * anchored there with memcmp(); same answers as has_lit() per alternative. */
+static uint64_t lit_mask(const struct altset *set, const char *s, size_t n) {
+  uint64_t found = 0;
+  size_t i = 0;
+
+#define PF_HIT(pos)                                                            \
+  do {                                                                         \
+    size_t q_ = (pos);                                                         \
+    uint64_t m_ = set->pfmask[set->pfslot[(unsigned char)s[q_]] - 1] & ~found; \
+    while (m_) {                                                               \
+      int b_ = __builtin_ctzll(m_);                                            \
+      const struct alt *a_ = &set->v[b_];                                      \
+      m_ &= m_ - 1;                                                            \
+      if (q_ >= a_->anc && q_ - a_->anc + a_->litn <= n &&                     \
+          !memcmp(s + q_ - a_->anc, a_->lit, a_->litn))                        \
+        found |= 1ULL << b_;                                                   \
+    }                                                                          \
+  } while (0)
+
+#ifdef __SSE2__
+  __m128i want[LIT_PF_MAX];
+  for (int k = 0; k < set->npf; ++k)
+    want[k] = _mm_set1_epi8((char)set->pf[k]);
+  for (; i + 16 <= n; i += 16) {
+    __m128i v = _mm_loadu_si128((const __m128i *)(s + i));
+    __m128i eq = _mm_cmpeq_epi8(v, want[0]);
+    for (int k = 1; k < set->npf; ++k)
+      eq = _mm_or_si128(eq, _mm_cmpeq_epi8(v, want[k]));
+    unsigned bits = (unsigned)_mm_movemask_epi8(eq);
+    while (bits) {
+      PF_HIT(i + (size_t)__builtin_ctz(bits));
+      bits &= bits - 1;
+    }
+  }
+#endif
+  for (; i < n; ++i)
+    if (set->pfslot[(unsigned char)s[i]])
+      PF_HIT(i);
+#undef PF_HIT
+  return found;
+}
+
+static void setup_prefilter(struct altset *set) {
+  set->npf = 0;
+  if (set->n > 64)
+    return;
+  memset(set->pfslot, 0, sizeof set->pfslot);
+  for (int i = 0; i < set->n; ++i) {
+    const struct alt *a = &set->v[i];
+    if (!a->lit)
+      continue;
+    unsigned char c = (unsigned char)a->lit[a->anc];
+    if (!set->pfslot[c]) {
+      if (set->npf == LIT_PF_MAX) {
+        set->npf = 0; /* too many: has_lit() per alternative */
+        return;
+      }
+      set->pf[set->npf] = c;
+      set->pfmask[set->npf] = 0;
+      set->pfslot[c] = (unsigned char)++set->npf;
+    }
+    set->pfmask[set->pfslot[c] - 1] |= 1ULL << i;
+  }
+}
+
 /* "wine" in a command line; 'w' is its least common byte. */
 static const struct alt wine_lit = {.lit = "wine", .litn = 4, .anc = 0};
 
