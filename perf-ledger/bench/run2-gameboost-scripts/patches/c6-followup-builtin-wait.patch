diff --git a/system/services/gameboost/scripts/start.sh b/system/services/gameboost/scripts/start.sh
index e46e1f1..3578f67 100644
--- a/system/services/gameboost/scripts/start.sh
+++ b/system/services/gameboost/scripts/start.sh
@@ -310,6 +310,20 @@ RENDER_SLICE_NS=500000   # default slice is 1.6-3 ms depending on the kernel
 RENDER_SAMPLE_S=3
 RENDER_MIN_BUSY=20       # percent of one CPU over the sample
 
+# wait_s SECONDS: sleep without a sleep process: a timed read on a pipe that
+# never gets data (opened read-write, so it never reaches EOF either). One
+# fork for the pipe instead of a fork and exec per sleep, and nothing is
+# left running when gameboostd SIGTERMs start.sh in the middle of a wait.
+WAIT_FD=
+wait_s() {
+    [ -n "$WAIT_FD" ] || exec {WAIT_FD}<> <(:)
+    if [ -n "$WAIT_FD" ]; then
+        read -r -t "$1" -u "$WAIT_FD" _
+    else
+        sleep "$1"   # no /dev/fd
+    fi
+}
+
 boost_render_thread() {
     local pid t tid name line head rest policy run base state d best= best_name= best_d=0 pref= pref_name= pref_d=0
     local -a f
@@ -327,7 +341,7 @@ boost_render_thread() {
             read -r run _ < "$t/schedstat" && t0[$t]=$run
         done
     done 2>/dev/null
-    sleep "$RENDER_SAMPLE_S"
+    wait_s "$RENDER_SAMPLE_S"
     [ -f "$FLAG" ] || return
 
     for t in "${!t0[@]}"; do
@@ -373,7 +387,7 @@ FOLLOW_UP=(10 boost 20 render 27 boost)   # +10 s, +30 s (+3 s sample), +60 s
 follow_up() {
     local i
     for ((i = 0; i < ${#FOLLOW_UP[@]}; i += 2)); do
-        sleep "${FOLLOW_UP[i]}"
+        wait_s "${FOLLOW_UP[i]}"
         [ -f "$FLAG" ] || return
         case ${FOLLOW_UP[i + 1]} in
             boost) boost_tree "$@" ;;
