-    sleep "$RENDER_SAMPLE_S"
+    wait_s "$RENDER_SAMPLE_S"
     [ -f "$FLAG" ] || return
 
     for t in "${!t0[@]}"; do
@@ -373,7 +422,7 @@ FOLLOW_UP=(10 boost 20 render 27 boost)   # +10 s, +30 s (+3 s sample), +60 s
 follow_up() {
     local i
     for ((i = 0; i < ${#FOLLOW_UP[@]}; i += 2)); do
