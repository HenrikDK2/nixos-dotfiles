diff --git a/system/services/gameboost/scripts/exit.sh b/system/services/gameboost/scripts/exit.sh
index 59f0958..cdcfca0 100644
--- a/system/services/gameboost/scripts/exit.sh
+++ b/system/services/gameboost/scripts/exit.sh
@@ -19,14 +19,22 @@ load_state() {
     done < "$STATE"
 }
 
-# restore_saved REGEX: restore matching entries, newest first (GPU profile
-# before level). Returns 1 without a state file.
+# restore_saved GROUP: restore the group's entries, newest first (GPU profile
+# before level). Returns 1 without a state file. The groups are literal glob
+# patterns, parsed once: a regex (=~) would be compiled anew for every entry.
 restore_saved() {
     ((HAVE_STATE)) || return 1
-    local i
+    local i f
     for ((i = ${#SAVED_FILES[@]} - 1; i >= 0; i--)); do
-        [[ ${SAVED_FILES[i]} =~ $1 ]] &&
-            echo "${SAVED_VALUES[i]}" > "${SAVED_FILES[i]}" 2>/dev/null
+        f=${SAVED_FILES[i]}
+        case $1 in
+            sata) [[ $f == *link_power_management_policy* ]] ;;
+            nvme) [[ $f == /sys/block/nvme* ]] ;;
+            pcie) [[ $f == /sys/bus/pci/devices/*/power/control || $f == *pcie_aspm* ]] ;;
+            cpu) [[ $f == *cpufreq* || $f == *intel_pstate* || $f == *amd_x3d_mode* || $f == *cpu.weight* ]] ;;
+            gpu) [[ $f == *pp_power_profile_mode* || $f == *power_dpm_force_performance_level* ||
+                $f == /sys/bus/pci/devices/*/power/control ]] ;;
+        esac && echo "${SAVED_VALUES[i]}" > "$f" 2>/dev/null
     done
     return 0
 }
@@ -40,7 +48,7 @@ set_cpu_governor() {
 
     systemctl stop --no-block gameboost-hold.service 2>/dev/null
 
-    restore_saved 'cpufreq|intel_pstate|amd_x3d_mode|cpu\.weight' && return
+    restore_saved cpu && return
 
     # power-profiles-daemon owns the governor and EPP: don't fight it.
     systemctl is-active --quiet power-profiles-daemon.service && return
@@ -83,7 +91,7 @@ set_cpu_governor() {
 set_gpu_auto() {
     local gpu class
 
-    restore_saved 'pp_power_profile_mode|power_dpm_force_performance_level|^/sys/bus/pci/devices/.*/power/control$' && return
+    restore_saved gpu && return
 
     # Fallback without state file: profile before level (needs "manual").
     for gpu in /sys/bus/pci/devices/*; do
@@ -119,7 +127,7 @@ kill_lingering_processes() {
 restore_sata_power_management() {
     local host
 
-    restore_saved 'link_power_management_policy' && return
+    restore_saved sata && return
 
     for host in /sys/class/scsi_host/host*/link_power_management_policy; do
         echo med_power_with_dipm > "$host" 2>/dev/null
@@ -129,7 +137,7 @@ restore_sata_power_management() {
 restore_nvme_power_management() {
     local nvme_dev
 
-    restore_saved '^/sys/block/nvme' && return
+    restore_saved nvme && return
 
     for nvme_dev in /sys/block/nvme*/device; do
         [ -d "$nvme_dev/power" ] || continue
@@ -141,7 +149,7 @@ restore_nvme_power_management() {
 restore_pcie_power_management() {
     local pci
 
-    restore_saved '^/sys/bus/pci/devices/.*/power/control$|pcie_aspm' && return
+    restore_saved pcie && return
 
     for pci in /sys/bus/pci/devices/*/power/control; do
         echo auto > "$pci" 2>/dev/null
