diff -ru a/system/services/gameboost/exit.sh b/system/services/gameboost/exit.sh
--- a/system/services/gameboost/exit.sh	2026-11-08 19:03:01.685431795 +0000
+++ b/system/services/gameboost/exit.sh	2026-11-08 19:03:01.686804240 +0000
