+/* Close fds in batches with one close_range() (Linux 5.9+) per run of
+ * contiguous fds. They are contiguous: openat() returns the lowest free fd
+ * and nothing else opens files during a scan or a round of checks; a gap
+ * just starts a new batch. */
+static int close_lo, close_n, use_close_range = 1;
+
+static void flush_closes(void) {
+  if (!close_n)
+    return;
+  if (!use_close_range ||
+      syscall(SYS_close_range, close_lo, close_lo + close_n - 1, 0)) {
+    use_close_range = 0; /* ENOSYS / seccomp: plain close from now on */
+    for (int i = close_lo; i < close_lo + close_n; ++i)
+      close(i);
+  }
+  close_n = 0;
+}
+
+static void defer_close(int fd) {
+  if (fd < 0)
+    return;
+  if (!use_close_range) {
+    close(fd);
+    return;
+  }
+  if (close_n && fd != close_lo + close_n) /* gap: flush, start anew */
+    flush_closes();
+  if (!close_n)
+    close_lo = fd;
+  if (++close_n >= CLOSE_BATCH)
+    flush_closes();
+}
+
 /* Read /proc/PID/cmdline into buf as one line: NULs/newlines become spaces,
